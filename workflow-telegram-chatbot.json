        -1888,
        448
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "queue",
              "name": "queue",
              "value": "={{ \n  $json.rawMessage.split(',')[1] \n    ? `${$json.rawMessage.split(',')[0].trim()},${$json.rawMessage.split(',')[1].trim()},${$json.rawMessage.split(',')[2] ? $json.rawMessage.split(',')[2].trim() : 'BR'}`\n    : `${$json.rawMessage.split(',')[0].trim()},BR`\n}}",
              "type": "string"
            },
            {
              "id": "9fe9e471-9d16-4b8b-a9f9-5bdf5ec339ca",
              "name": "city",
              "value": "={{ $json.rawMessage.split(',')[0] ? $json.rawMessage.split(',')[0].trim() : '' }}",
              "type": "string"
            },
            {
              "id": "8d755f4a-ed9c-40f9-82fe-5feea237442b",
              "name": "uf",
              "value": "={{ $json.rawMessage.split(',')[1] ? $json.rawMessage.split(',')[1].trim() : '' }}",
              "type": "string"
            },
            {
              "id": "1c3aa018-56b1-4a11-af5f-22637864df25",
              "name": "country",
              "value": "={{ $json.rawMessage.split(',')[2] ? $json.rawMessage.split(',')[2].trim() : 'BR' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1aeb1f5b-3365-4ef3-a7a8-b98bf62cf72c",
      "name": "Normalizar Entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1648,
        320
      ]
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "pt_br"
            },
            {
              "name": "appid",
              "value": "={{ $env.OPENWEATHER_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "df835618-d54e-46b6-b913-3fbf8f6483c2",
      "name": "Consultar OpenWeather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1408,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "resposta-valida",
              "leftValue": "={{ $json.main?.temp }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3897ce5f-9c2f-438b-a0b1-3375610a881f",
